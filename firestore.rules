rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------
    // RANKING (pontuações de todos os jogadores)
    // -------------------------------------------------------------------
    // - Qualquer pessoa pode VER o ranking (leitura pública).
    // - Só quem está logado pode adicionar a PRÓPRIA pontuação
    //   (o campo uid precisa ser o mesmo de quem está logado).
    // - Ninguém pode editar nem apagar pontuação (nem a sua, nem a dos outros).
    match /ranking/{doc} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.score is int
                    && request.resource.data.score >= 0;
      allow update, delete: if false;
    }

    // -------------------------------------------------------------------
    // PROGRESSO DE CADA USUÁRIO (XP, fase, conquistas)
    // -------------------------------------------------------------------
    // - Só o próprio dono lê e escreve o documento dele.
    //   (o id do documento é o uid do usuário logado)
    match /users/{uid} {
      allow read, write: if request.auth != null
                         && request.auth.uid == uid;
    }

    // Qualquer outro caminho fica bloqueado por padrão.
  }
}
